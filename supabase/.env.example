# Service Role — NÃO COMMITAR / NÃO USAR NO FRONTEND
#
# A service_role key só deve existir no painel do Supabase (Edge Functions
# já recebem SUPABASE_SERVICE_ROLE_KEY automaticamente no deploy).
#
# Guarde este valor apenas em um cofre local seguro, fora do repositório.
#
# SUPABASE_SERVICE_ROLE_KEY=cole-aqui-se-precisar-para-testes-locais-com-supabase-functions-serve

# Cloudflare R2 — secrets da Edge Function sync-card-images (também via `supabase secrets set`)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=card-images
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# R2_SOFT_LIMIT_BYTES=9663676416
